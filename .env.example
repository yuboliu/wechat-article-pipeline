# ============================================================================
# wechat-article-pipeline 配置模板
# ----------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env            cp .env.example .env
#   2. 把 WECHAT_VAULT 改成你自己的 vault 根目录
#   3. 校验：python scripts/setup_env.py --check
#   或者直接跑向导，自动生成 .env：python scripts/setup_env.py
#
# ⚠️ 本文件（.env.example）会提交到公开仓库，**只能放占位符**。
#    真实路径一律写进 .env —— 它已在 .gitignore 里，不会被提交。
# ============================================================================

# 【必填】Obsidian vault 根目录：即那个里面有 .obsidian 文件夹的目录。
#   不填的话，脚本会提示你先配置；sync_to_vault.py 无法工作（其余步骤不受影响）。
WECHAT_VAULT=/path/to/your/obsidian-vault

# ---- 落库目录 --------------------------------------------------------------
# 一级目录的通配模式（推荐）。目录以后改名、加编号前缀都不用改配置：
#   *公众号 能命中「公众号」「【15】公众号」等。
WECHAT_SUBFOLDER_PATTERN=*公众号

# 想写死具体目录名时填这里。一旦有值，优先级高于上面的通配。
# WECHAT_SUBFOLDER=公众号

# ---- 索引页 ----------------------------------------------------------------
# vault 根下「知识库索引」的文件名通配。
WECHAT_INDEX_PATTERN=*知识库索引*.md

# ---- 可选：路径与资源 ------------------------------------------------------
# 抓取/转换产物根目录。留空 = <当前工作目录>/output
# WECHAT_OUTPUT_BASE=

# 标签词表与索引布局（一般不用改，留空用仓库自带的那份）
# WECHAT_TAXONOMY=
# WECHAT_INDEX_LAYOUT=

# ---- 可选：本机备忘（脚本不读，只给人看） ----------------------------------
# 跑流水线用的解释器
# WECHAT_PYTHON=
